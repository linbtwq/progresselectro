// http-сервис сайта прогрес электро для новой конфигурации

Функция ВернутьПараметрыСотрудника(КодСотр)
	// структура в которую сложим ответ
	Результат = Новый Структура;
	// убираем пробелы по краям чтобы пин с лишним пробелом не ломал поиск
	КодСотр = СокрЛП(КодСотр);
	// заранее готовим пустые ссылки чтобы вернуть их если никого не нашли
	Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Пользователь = Справочники.Пользователи.ПустаяСсылка();

	// пустой код сразу отдаем пустой результат
	// нет смысла гонять запрос в базу с пустым условием
	Если ПустаяСтрока(КодСотр) Тогда
		Результат.Вставить("Пользователь", Пользователь);
		Результат.Вставить("Сотрудник", Сотрудник);
		Возврат Результат;
	КонецЕсли;

	// ищем пользователя по полю код карты
	// первые 1 потому что пин должен быть уникальным
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка,
	|	Пользователи.Сотрудник КАК Сотрудник
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.КодКарты = &КодКарты
	|	И НЕ Пользователи.ПометкаУдаления
	|	И НЕ Пользователи.Сотрудник.ПометкаУдаления";

	// код передаем параметром а не склеиваем в текст
	// так безопаснее и не будет инъекции в запрос
	Запрос.УстановитьПараметр("КодКарты", КодСотр);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	// берем первую найденную запись
	// цикл тут нужен просто чтобы прочитать единственную строку выборки
	Пока Выборка.Следующий() Цикл
		Результат.Вставить("Пользователь", Выборка.Ссылка);
		Результат.Вставить("Сотрудник", Выборка.Сотрудник);
		Возврат Результат;
	КонецЦикла;

	// если никого не нашли возвращаем пустые значения
	// вызывающий код проверяет это через ЗначениеЗаполнено(Сотрудник)
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сотрудник", Сотрудник);
	Возврат Результат;

КонецФункции

Функция КодСотрудникаЗапроса(Запрос)
    Код = Запрос.Заголовки.Получить("X-User-Code");
    Если Код = Неопределено Тогда Код = Запрос.Заголовки.Получить("x-user-code"); КонецЕсли;
    // совместимость с ранее установленными клиентами. новый клиент PIN в URL не передаёт.
    Если Код = Неопределено Тогда Код = Запрос.ПараметрыЗапроса.Получить("u"); КонецЕсли;
    Возврат ?(Код = Неопределено, "", СокрЛП(Строка(Код)));
КонецФункции

Функция POST_login(Запрос) Экспорт
	СтрокаJSON = Запрос.ПолучитьТелоКакСтроку();

	// пустое тело это неверный запрос
	// отвечаем 400 без тела
	Если ПустаяСтрока(СтрокаJSON) Тогда
		Ответ = Новый HTTPСервисОтвет(400);
		Возврат Ответ;
	КонецЕсли;

	// разбираем json и достаем pin
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	ПинКод = ДанныеЗапроса.pin;
	// вся логика проверки вынесена в отдельную функцию которая сразу возвращает готовый json
	РезультатJSON = АвторизоватьПользователя(ПинКод);

	// здесь всегда 200 даже если пин неверный
	// неверный пин фронт узнает по полю code равному нулю
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code, ngrok-skip-browser-warning");
	Ответ.УстановитьТелоИзСтроки(РезультатJSON, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция OPTIONS_login(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "POST, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции

Функция АвторизоватьПользователя(КодАвторизации)
	Данные = Новый Структура;

	// пустой пин сразу отбиваем
	Если ПустаяСтрока(КодАвторизации) Тогда
		Данные.Вставить("Code", "0");
		Данные.Вставить("Name", "Порожній код");
		Данные.Вставить("IsAdmin", Ложь);
	Иначе
		// ищем неудаленного пользователя с таким кодом карты
		// если реквизит администратора пустой то считаем что не админ
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.КодКарты КАК КодКарты,
		|	Пользователи.Сотрудник.Наименование КАК Имя,
		|	ЕСТЬNULL(Пользователи.Сотрудник.РольАдминистратора, ЛОЖЬ) КАК РольАдминистратора
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.КодКарты = &Код
		|	И НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Сотрудник.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", СокрЛП(КодАвторизации));
		Выборка = Запрос.Выполнить().Выбрать();

		// нашли пользователя отдаем его данные
		Если Выборка.Следующий() Тогда
			Данные.Вставить("Code", СокрЛП(Выборка.КодКарты));
			Данные.Вставить("Name", Выборка.Имя);
			Данные.Вставить("IsAdmin", Выборка.РольАдминистратора);
		Иначе
			// не нашли значит пин неверный или пользователь удален
			Данные.Вставить("Code", "0");
			Данные.Вставить("Name", "НЕ ЗНАЙДЕНО");
			Данные.Вставить("IsAdmin", Ложь);
		КонецЕсли;
	КонецЕсли;

	// превращаем структуру в json строку и возвращаем
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ТоварыОтвет(КодОтвета, Тело, Методы, ЭтоJSON = Истина)
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", ?(ЭтоJSON, "application/json; charset=utf-8", "text/plain; charset=utf-8"));
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", Методы);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	Возврат Ответ;
КонецФункции

Функция ТоварыВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПараметрТоваров(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);
КонецФункции

Функция ТоварыСсылкаПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	// конструктор уникального идентификатора падает на кривой строке поэтому в попытке
	Попытка
		Уид = Новый УникальныйИдентификатор(Ид);
		Возврат Справочники.Номенклатура.ПолучитьСсылку(Уид);
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;
КонецФункции

Функция ТоварыХлебныеКрошки(Ссылка)
	Крошки = Новый Массив;
	Текущий = Ссылка;

	Пока ЗначениеЗаполнено(Текущий) Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("id",   Строка(Текущий.УникальныйИдентификатор()));
		Элемент.Вставить("name", СокрЛП(Текущий.Наименование));
		// вставка по индексу ноль чтобы корень оказался первым
		Крошки.Вставить(0, Элемент);
		Текущий = Текущий.Родитель;
	КонецЦикла;

	Возврат Крошки;
КонецФункции

// показывает измерения и ресурсы регистра цен для диагностики
Функция ТоварыОписаниеРегистраЦен()
	Инфо = "";
	Попытка
		Рег = Метаданные.РегистрыСведений.ЦеныНоменклатуры_переодический;
		Инфо = "Измерения:";
		Для Каждого Эл Из Рег.Измерения Цикл
			Инфо = Инфо + " " + Эл.Имя + ";";
		КонецЦикла;
		Инфо = Инфо + " Ресурсы:";
		Для Каждого Эл Из Рег.Ресурсы Цикл
			Инфо = Инфо + " " + Эл.Имя + ";";
		КонецЦикла;
	Исключение
		Инфо = "Регистр не найден в метаданных.";
	КонецПопытки;
	Возврат Инфо;
КонецФункции

Функция ТоварыЦены(МассивСсылок)
	Цены = Новый Соответствие;
	// пустой список не гоняем в базу
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Цены;
	КонецЕсли;

	// срез последних берет самую свежую цену на текущую дату по каждому сочетанию измерений
	// цены равные нулю отбрасываем сразу
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.ТипЦен.Наименование КАК ТипЦен,
	|	Цены.Магазин.Наименование КАК Магазин,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры_переодический.СрезПоследних(
	|		&Дата,
	|		Номенклатура В (&Список)) КАК Цены
	|ГДЕ
	|	Цены.Цена > 0";
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("Список", МассивСсылок);

	// при ошибке добавляем к тексту описание регистра чтобы было проще понять что не так
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ Символы.ПС + ТоварыОписаниеРегистраЦен();
	КонецПопытки;

	// ранги по товарам чем меньше число тем цена приоритетнее
	Ранги = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		// сравниваем в верхнем регистре чтобы не зависеть от того как написано в базе
		ТипЦен = ВРег(СокрЛП(Выборка.ТипЦен));
		Магазин = ВРег(СокрЛП(Выборка.Магазин));

		// оптовая лучше всего потом розничная потом все остальные
		Если ТипЦен = ВРег("Оптова") Тогда
			Ранг = 1;
		ИначеЕсли ТипЦен = ВРег("Розничная") Тогда
			Ранг = 3;
		Иначе
			Ранг = 5;
		КонецЕсли;

		// если цена не с основного склада то она хуже на единицу
		Если Магазин <> ВРег("Основной склад") Тогда
			Ранг = Ранг + 1;
		КонецЕсли;

		// запоминаем цену только если она лучше уже найденной для этого товара
		ТекущийРанг = Ранги[Выборка.Номенклатура];
		Если ТекущийРанг = Неопределено ИЛИ Ранг < ТекущийРанг Тогда
			Ранги.Вставить(Выборка.Номенклатура, Ранг);
			Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
		КонецЕсли;
	КонецЦикла;

	Возврат Цены;
КонецФункции

Функция ТоварыОстатки(МассивСсылок, Пользователь)
	Остатки = Новый Соответствие;
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат Остатки;
	КонецЕсли;

	Магазин = глСобытия.ПолучитьЗначениеПоУмолчанию(Пользователь, "ОсновнойМагазин");
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// остатки одним запросом на весь список
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Номенклатура КАК Номенклатура,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.Остатки.Остатки(
	|		,
	|		Магазин = &Магазин
	|		И Номенклатура В (&Список)) КАК Ост
	|СГРУППИРОВАТЬ ПО
	|	Ост.Номенклатура";
	Запрос.УстановитьПараметр("Магазин", Магазин);
	Запрос.УстановитьПараметр("Список", МассивСсылок);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	Возврат Остатки;
КонецФункции

Процедура ТоварыДобавитьОстаток(Позиция, Остатки, Ссылка)
	Если Остатки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ост = Остатки[Ссылка];
	Позиция.Вставить("stock", ?(Ост = Неопределено, 0, Ост));
КонецПроцедуры

Функция ТоварыСодержимое(ИдРодителя, Пользователь)
	РодительСсылка = ТоварыСсылкаПоИд(ИдРодителя);

	// если id передали но ссылка получилась пустая значит такой папки нет
	Если Не ПустаяСтрока(ИдРодителя) И РодительСсылка.Пустая() Тогда
		ВызватьИсключение "Групу не знайдено.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование,
	|	Ном.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Родитель = &Родитель
	|	И НЕ Ном.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоГруппа УБЫВ,
	|	Наименование";
	Запрос.УстановитьПараметр("Родитель", РодительСсылка);

	// выгружаем в таблицу значений чтобы пройти по ней дважды
	Таблица = Запрос.Выполнить().Выгрузить();

	// цены нужны только для товаров а не для папок
	МассивТоваров = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Если Не Стр.ЭтоГруппа Тогда
			МассивТоваров.Добавить(Стр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	// все цены одним запросом
	Цены = ТоварыЦены(МассивТоваров);
	Остатки = ТоварыОстатки(МассивТоваров, Пользователь);

	Позиции = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Стр.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Стр.Наименование));
		// type говорит фронту что рисовать папку или товар
		Позиция.Вставить("type", ?(Стр.ЭтоГруппа, "folder", "item"));

		// у папки нет кода и цены
		Если НЕ Стр.ЭтоГруппа Тогда
			Позиция.Вставить("code", СокрЛП(Стр.Код));
			Цена = Цены[Стр.Ссылка];
			Позиция.Вставить("price", ?(Цена = Неопределено, 0, Цена));
			ТоварыДобавитьОстаток(Позиция, Остатки, Стр.Ссылка);
		КонецЕсли;

		Позиции.Добавить(Позиция);
	КонецЦикла;

	// parent и breadcrumb нужны фронту для кнопки назад и пути сверху
	Результат = Новый Структура;
	Результат.Вставить("parent",     ИдРодителя);
	Результат.Вставить("breadcrumb", ТоварыХлебныеКрошки(РодительСсылка));
	Результат.Вставить("items",      Позиции);
	Возврат Результат;
КонецФункции

Функция ТоварыПоиск(СтрокаПоиска, Пользователь)
	СтрокаПоиска = СокрЛП(СтрокаПоиска);

	// проверяем что в строке только цифры
	// идем по символам и ищем каждый среди цифр
	ТолькоЦифры = Ложь;
	Если СтрДлина(СтрокаПоиска) > 0 Тогда
		ТолькоЦифры = Истина;
		Для Индекс = 1 По СтрДлина(СтрокаПоиска) Цикл
			Если Найти("0123456789", Сред(СтрокаПоиска, Индекс, 1)) = 0 Тогда
				ТолькоЦифры = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МаскаИмени", "%" + СтрокаПоиска + "%");

	Если ТолькоЦифры Тогда
		// код может быть числом или строкой и сравнивать его в запросе ненадежно
		// цифровой код может иметь тип число, поэтому ищем в строковом представлении ниже
		// лимит применяется после фильтрации, чтобы не потерять совпадения после первых строк
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ном.Ссылка КАК Ссылка,
		|	Ном.Код КАК Код,
		|	Ном.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|ГДЕ
		|	НЕ Ном.ПометкаУдаления
		|	И НЕ Ном.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Ном.Код";
	Иначе
		// поиск по части названия
		// берем 51 чтобы понять что результатов больше пятидесяти
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ном.Ссылка КАК Ссылка,
		|	Ном.Код КАК Код,
		|	Ном.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|ГДЕ
		|	НЕ Ном.ПометкаУдаления
		|	И НЕ Ном.ЭтоГруппа
		|	И Ном.Наименование ПОДОБНО &МаскаИмени
		|УПОРЯДОЧИТЬ ПО
		|	Ном.Код";
		Запрос.УстановитьПараметр("МаскаИмени", "%" + СтрокаПоиска + "%");
	КонецЕсли;

	ВерхняяСтрока = ВРег(СтрокаПоиска);
	Позиции = Новый Массив;
	МассивСсылок = Новый Массив;
	// усечено значит нашлось больше пятидесяти и фронт покажет подсказку уточнить поиск
	Усечено = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		// код приводим к строке без разделителей групп чтобы 122065 не превратилось в 122 065
		КодСтрокой = ?(ТипЗнч(Выборка.Код) = Тип("Число"),
			Формат(Выборка.Код, "ЧГ=0"),
			СокрЛП(Выборка.Код));
		ИмяСтрокой = СокрЛП(Выборка.Наименование);

		// для цифрового поиска фильтруем здесь
		// подходит если цифры есть в коде или в названии
		Если ТолькоЦифры Тогда
			Если Найти(КодСтрокой, СтрокаПоиска) = 0
				И Найти(ВРег(ИмяСтрокой), ВерхняяСтрока) = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// пятьдесят максимум для ответа
		Если Позиции.Количество() >= 50 Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", ИмяСтрокой);
		Позиция.Вставить("code", КодСтрокой);
		Позиция.Вставить("type", "item");
		Позиции.Добавить(Позиция);
		// ссылки копим отдельно для запроса цен
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	// цены одним запросом на все найденное
	// индекс в массиве позиций совпадает с индексом в массиве ссылок
	Цены = ТоварыЦены(МассивСсылок);
	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Цена = Цены[МассивСсылок[Индекс]];
		Позиции[Индекс].Вставить("price", ?(Цена = Неопределено, 0, Цена));
	КонецЦикла;

	Остатки = ТоварыОстатки(МассивСсылок, Пользователь);
	Для Индекс = 0 По Позиции.ВГраница() Цикл
		ТоварыДобавитьОстаток(Позиции[Индекс], Остатки, МассивСсылок[Индекс]);
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("items",     Позиции);
	Результат.Вставить("truncated", Усечено);
	Возврат Результат;
КонецФункции

// ищет товар по точному штрихкоду
Функция ТоварыПоискПоШтрихкоду(ШтрихКод, Пользователь)
	Ш = СокрЛП(ШтрихКод);

	// соединяем единицы измерения с номенклатурой через владельца
	// различные нужны если у одного товара несколько единиц с одним кодом
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ЕдиницыИзмерения КАК Ед
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
	|		ПО Ед.Владелец = Ном.Ссылка
	|ГДЕ
	|	Ед.Код = &Код
	|	И НЕ Ед.ПометкаУдаления
	|	И НЕ Ном.ПометкаУдаления
	|	И НЕ Ном.ЭтоГруппа";
	Запрос.УстановитьПараметр("Код", Ш);

	Позиции = Новый Массив;
	МассивСсылок = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	// формат позиции такой же как у обычного поиска чтобы фронт не пришлось менять
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("id",   Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиция.Вставить("code", ?(ТипЗнч(Выборка.Код) = Тип("Число"),
			Формат(Выборка.Код, "ЧГ=0"),
			СокрЛП(Выборка.Код)));
		Позиция.Вставить("type", "item");
		Позиция.Вставить("barcode", Ш);
		Позиции.Добавить(Позиция);
		МассивСсылок.Добавить(Выборка.Ссылка);
	КонецЦикла;

	// цены и остатки одним запросом на все найденное
	// индекс в массиве позиций совпадает с индексом в массиве ссылок
	Цены = ТоварыЦены(МассивСсылок);
	Остатки = ТоварыОстатки(МассивСсылок, Пользователь);
	Для Индекс = 0 По Позиции.ВГраница() Цикл
		Цена = Цены[МассивСсылок[Индекс]];
		Позиции[Индекс].Вставить("price", ?(Цена = Неопределено, 0, Цена));
		ТоварыДобавитьОстаток(Позиции[Индекс], Остатки, МассивСсылок[Индекс]);
	КонецЦикла;

	// если ничего не нашли список будет пустой и фронт покажет что найдено ноль
	Возврат Новый Структура("items, truncated", Позиции, Ложь);
КонецФункции

// выдает основное фото товара из хранилища 1с
Функция ФотоТовара(Код)
	Товар = Справочники.Номенклатура.НайтиПоКоду(Число(Код));
	Если Не ЗначениеЗаполнено(Товар) ИЛИ Товар.ПометкаУдаления ИЛИ Товар.ЭтоГруппа
		ИЛИ Не ЗначениеЗаполнено(Товар.ОсновноеИзображение) Тогда
		Возврат ТоварыОтвет(404, "", "GET, OPTIONS", Ложь);
	КонецЕсли;
	Файл = Товар.ОсновноеИзображение;
	Данные = Файл.Хранилище.Получить();
	Если ТипЗнч(Данные) = Тип("Картинка") Тогда
		Данные = Данные.ПолучитьДвоичныеДанные();
	КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат ТоварыОтвет(404, "", "GET, OPTIONS", Ложь);
	КонецЕсли;
	// определяем формат по содержимому, даже если имя файла пустое
	Сигнатура = Лев(Base64Строка(Данные), 12);
	ТипФото = "";
	Если Лев(Сигнатура, 4) = "/9j/" Тогда
		ТипФото = "image/jpeg";
	ИначеЕсли Лев(Сигнатура, 10) = "iVBORw0KGg" Тогда
		ТипФото = "image/png";
	ИначеЕсли Лев(Сигнатура, 6) = "R0lGOD" Тогда
		ТипФото = "image/gif";
	КонецЕсли;
	Если ПустаяСтрока(ТипФото) Тогда
		Возврат ТоварыОтвет(404, "", "GET, OPTIONS", Ложь);
	КонецЕсли;
	Ответ = ТоварыОтвет(200, "", "GET, OPTIONS", Ложь);
	Ответ.Заголовки.Вставить("Content-Type", ТипФото);
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.Заголовки.Вставить("Cache-Control", "private, max-age=3600");
	Ответ.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Ответ;
КонецФункции

// Полный справочник порциями, независимо от папок и лимитов поиска.
Функция ТоварыОфлайн(Курсор, Пользователь, Настройки)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 301 Ном.Ссылка КАК Ссылка, Ном.Код КАК Код, Ном.Наименование КАК Имя
	|ИЗ Справочник.Номенклатура КАК Ном
	|ГДЕ НЕ Ном.ПометкаУдаления И НЕ Ном.ЭтоГруппа
	|	И (&Начало ИЛИ Ном.Код > &Курсор)
	|УПОРЯДОЧИТЬ ПО Код");
	Запрос.УстановитьПараметр("Начало", ПустаяСтрока(Курсор));
	Запрос.УстановитьПараметр("Курсор", ?(ПустаяСтрока(Курсор), 0, Число(Курсор)));
	Таблица = Запрос.Выполнить().Выгрузить();
	Еще = Таблица.Количество() > 300;
	Если Еще Тогда
		Таблица.Удалить(300);
	КонецЕсли;
	Ссылки = Таблица.ВыгрузитьКолонку("Ссылка");
	Цены = ТоварыЦены(Ссылки);
	Остатки = ТоварыОстатки(Ссылки, Пользователь);
	МестаОстатков = МестаОстатковТоваров(Ссылки, Настройки, Цены);
	Штрихкоды = Новый Соответствие;
	Если Ссылки.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Ед.Владелец КАК Товар, Ед.Код КАК Код
		|ИЗ Справочник.ЕдиницыИзмерения КАК Ед
		|ГДЕ Ед.Владелец В (&Товары) И НЕ Ед.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Код");
		Запрос.УстановитьПараметр("Товары", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Код = СокрЛП(Строка(Выборка.Код));
			Если ПустаяСтрока(Код) Тогда
				Продолжить;
			КонецЕсли;
			Коды = Штрихкоды.Получить(Выборка.Товар);
			Если Коды = Неопределено Тогда
				Коды = Новый Массив;
				Штрихкоды.Вставить(Выборка.Товар, Коды);
			КонецЕсли;
			Коды.Добавить(Код);
		КонецЦикла;
	КонецЕсли;
	Позиции = Новый Массив;
	ПоследнийКод = "";
	Для Каждого Стр Из Таблица Цикл
		ПоследнийКод = Формат(Стр.Код, "ЧГ=0");
		Цена = Цены.Получить(Стр.Ссылка);
		Коды = Штрихкоды.Получить(Стр.Ссылка);
		Позиция = Новый Структура("id, code, name, price, barcodes", Строка(Стр.Ссылка.УникальныйИдентификатор()),
			ПоследнийКод, Стр.Имя, ?(Цена = Неопределено, 0, Цена), ?(Коды = Неопределено, Новый Массив, Коды));
		ТоварыДобавитьОстаток(Позиция, Остатки, Стр.Ссылка);
		Места = МестаОстатков.Получить(Стр.Ссылка);
		Позиция.Вставить("stock_locations", ?(Места = Неопределено, Новый Массив, Места));
		Позиции.Добавить(Позиция);
	КонецЦикла;
	Возврат Новый Структура("schema, items, next_cursor", 1, Позиции, ?(Еще, ПоследнийКод, ""));
КонецФункции

// выбирает режим каталога по параметрам запроса
Функция goodsget(Запрос) Экспорт
	Методы = "GET, OPTIONS";
	Попытка
		// сначала проверяем кто спрашивает
		ПарамПользователя = ВернутьПараметрыСотрудника(КодСотрудникаЗапроса(Запрос));
		Если Не ЗначениеЗаполнено(ПарамПользователя.Сотрудник) Тогда
			ВызватьИсключение "Співробітника не знайдено.";
		КонецЕсли;
		// пользователь нужен всем веткам чтобы посчитать остаток на его складе
		Пользователь = ПарамПользователя.Пользователь;
		Если ПараметрТоваров(Запрос, "offline") = "1" Тогда
			Порция = ТоварыОфлайн(ПараметрТоваров(Запрос, "cursor"), Пользователь, НастройкиОтгрузки(Запрос));
			Если ПараметрТоваров(Запрос, "fingerprints") <> "1" Тогда
				Возврат ТоварыОтвет(200, ТоварыВJSON(Порция), Методы);
			КонецЕсли;
			// сравниваем всю порцию, включая цены, остатки и штрихкоды
			Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
			Хеш.Добавить(ПолучитьДвоичныеДанныеИзСтроки(ТоварыВJSON(Порция), КодировкаТекста.UTF8));
			Отпечаток = Base64Строка(Хеш.ХешСумма);
			Если Отпечаток = ПараметрТоваров(Запрос, "fingerprint") Тогда
				Порция.Удалить("items");
				Порция.Вставить("unchanged", Истина);
			КонецЕсли;
			Порция.Вставить("fingerprint", Отпечаток);
			Возврат ТоварыОтвет(200, ТоварыВJSON(Порция), Методы);
		КонецЕсли;


		// обрабатываем фото после проверки сотрудника
		КодФото = ПараметрТоваров(Запрос, "photo");
		Если Не ПустаяСтрока(КодФото) Тогда
			Возврат ФотоТовара(КодФото);
		КонецЕсли;

		// --- блок штрих-кода ---
		// приоритет у штрихкода потому что скан должен сработать сразу
		ШтрихКод = ПараметрТоваров(Запрос, "barcode");
		Если Не ПустаяСтрока(ШтрихКод) Тогда
			Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыПоискПоШтрихкоду(ШтрихКод, Пользователь)), Методы);
		КонецЕсли;
		// ---------------------------------------

		// дальше обычный текстовый поиск
		СтрокаПоиска = ПараметрТоваров(Запрос, "q");
		Если Не ПустаяСтрока(СтрокаПоиска) Тогда
			Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыПоиск(СтрокаПоиска, Пользователь)), Методы);
		КонецЕсли;

		// если ни штрихкода ни поиска то показываем папку
		// пустой parent значит корень
		ИдРодителя = ПараметрТоваров(Запрос, "parent");
		Возврат ТоварыОтвет(200, ТоварыВJSON(ТоварыСодержимое(ИдРодителя, Пользователь)), Методы);

	Исключение
		Возврат ТоварыОтвет(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Методы, Ложь);
	КонецПопытки;
КонецФункции

Функция goodsoptions(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Access-Control-Allow-Origin", "*");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Methods", "GET, OPTIONS");
	Ответ.Заголовки.Вставить("Access-Control-Allow-Headers", "Content-Type, Authorization, X-User-Code, ngrok-skip-browser-warning");
	Возврат Ответ;
КонецФункции

// находит единственный действующий элемент справочника по точному наименованию
Функция НайтиРеквизитЗаказа(ИмяСправочника, Наименование)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 2 Элемент.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Элемент
	|ГДЕ Элемент.Наименование = &Наименование
	|И НЕ Элемент.ПометкаУдаления");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Элементы = Запрос.Выполнить().Выгрузить();
	Если Элементы.Количество() <> 1 Тогда
		ВызватьИсключение "Перевірте довідник " + ИмяСправочника + ": " + Наименование;
	КонецЕсли;
	Возврат Элементы[0].Ссылка;
КонецФункции

// возвращает сотрудника и общие настройки магазина для поиска и записи заказа
Функция НастройкиОтгрузки(Запрос, Источник = Неопределено)
	Параметры = ВернутьПараметрыСотрудника(КодСотрудникаЗапроса(Запрос));
	Если Не ЗначениеЗаполнено(Параметры.Сотрудник) Тогда
		ВызватьИсключение "Співробітника не знайдено або доступ відкликано.";
	КонецЕсли;
	Магазин = НайтиРеквизитЗаказа("Магазины", "Прогрес Електро");
	// выбираем организацию по коду из карточки справочника
	Организация = Справочники.Организации.НайтиПоКоду(10);
	Если Не ЗначениеЗаполнено(Организация) ИЛИ Организация.ПометкаУдаления Тогда
		ВызватьИсключение "Перевірте довідник Организации: код 10.";
	КонецЕсли;
	Если Источник <> Неопределено Тогда
		Если ТипЗнч(Источник) <> Тип("Структура") Или Не Источник.Свойство("organization_id")
			Или Не Источник.Свойство("store_id") Тогда
			ВызватьИсключение "Некоректна організація або магазин замовлення.";
		КонецЕсли;
		Организация = Справочники.Организации.ПолучитьСсылку(Новый УникальныйИдентификатор(Источник.organization_id));
		Магазин = Справочники.Магазины.ПолучитьСсылку(Новый УникальныйИдентификатор(Источник.store_id));
		Если Организация.ПолучитьОбъект() = Неопределено Или Магазин.ПолучитьОбъект() = Неопределено
			Или Организация.ПометкаУдаления Или Магазин.ПометкаУдаления Тогда
			ВызватьИсключение "Організація або магазин замовлення недоступні.";
		КонецЕсли;
	КонецЕсли;
	Если ЗапрещенаОтгрузкаОрганизации(Организация) Тогда
		ВызватьИсключение "Для організації заборонено відвантаження.";
	КонецЕсли;
	ТипЦен = Магазин.ТипЦенНоменклатуры;
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		ТипЦен = глЗначениеПеременной("ТипРозничнойЦены");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		ВызватьИсключение "Не налаштовано тип цін для магазину.";
	КонецЕсли;
	Параметры.Вставить("Магазин", Магазин);
	Параметры.Вставить("Организация", Организация);
	Параметры.Вставить("ТипЦен", ТипЦен);
	Возврат Параметры;
КонецФункции

Функция ЗапрещенаОтгрузкаОрганизации(Организация)
	Возврат Организация.ЗаборонаВідвантадення;
КонецФункции

// суммирует партии одной организации и магазина в одну строку товара
Функция ОстаткиОтгрузки(Настройки, Товары, Характеристика = Неопределено)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ост.Номенклатура КАК Товар,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.Остатки.Остатки(,
	|	Магазин = &Магазин И Организация = &Организация
	|	И Характеристика = &БезХарактеристики И Номенклатура В (&Товары)) КАК Ост
	|ГДЕ НЕ Ост.Номенклатура.ПометкаУдаления
	|	И НЕ Ост.Номенклатура.ЭтоГруппа
	|СГРУППИРОВАТЬ ПО Ост.Номенклатура
	|ИМЕЮЩИЕ СУММА(Ост.КоличествоОстаток) > 0
	|УПОРЯДОЧИТЬ ПО Товар");
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("Магазин", Настройки.Магазин);
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Запрос.УстановитьПараметр("БезХарактеристики", ?(Характеристика = Неопределено, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(), Характеристика));
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// ищет ограниченный список кандидатов по имени, точному коду или штрихкоду
Функция НайтиТоварыЗаказа(СтрокаПоиска, Штрихкод)
	Запрос = Новый Запрос;
	Если Не ПустаяСтрока(Штрихкод) Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 51 Ном.Ссылка КАК Товар
		|ИЗ Справочник.ЕдиницыИзмерения КАК Ед
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Ном
		|	ПО Ед.Владелец = Ном.Ссылка
		|ГДЕ Ед.Код = &Штрихкод И НЕ Ед.ПометкаУдаления
		|	И НЕ Ном.ПометкаУдаления И НЕ Ном.ЭтоГруппа
		|СГРУППИРОВАТЬ ПО Ном.Ссылка
		|УПОРЯДОЧИТЬ ПО Товар";
		Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	Иначе
		Код = -1;
		Попытка
			Код = Число(СтрокаПоиска);
		Исключение
			// для текстового запроса используется только совпадение названия
		КонецПопытки;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 51 Ном.Ссылка КАК Товар,
		|	ВЫБОР КОГДА Ном.Код = &Код ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Порядок,
		|	Ном.Наименование КАК Наименование
		|ИЗ Справочник.Номенклатура КАК Ном
		|ГДЕ НЕ Ном.ПометкаУдаления И НЕ Ном.ЭтоГруппа
		|	И (Ном.Код = &Код ИЛИ Ном.Наименование ПОДОБНО &Маска)
		|УПОРЯДОЧИТЬ ПО Порядок, Наименование, Товар";
		Запрос.УстановитьПараметр("Код", Код);
		Запрос.УстановитьПараметр("Маска", "%" + Лев(СтрокаПоиска, 100) + "%");
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Товар");
КонецФункции

// читает остаток и цену только для найденных товаров
// показывает положительные остатки найденного товара по месту и владельцу
Функция МестаОстатковТоваров(Товары, Настройки, Цены)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ост.Номенклатура КАК Товар,
	|	ПРЕДСТАВЛЕНИЕ(Ост.Магазин) КАК Магазин,
	|	ПРЕДСТАВЛЕНИЕ(Ост.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(Ост.Характеристика) КАК Характеристика,
	|	Ост.Магазин КАК СсылкаМагазина,
	|	Ост.Организация КАК СсылкаОрганизации,
	|	Ост.Характеристика КАК СсылкаХарактеристики,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество
	|ИЗ РегистрНакопления.Остатки.Остатки(, Номенклатура В (&Товары)) КАК Ост
	|СГРУППИРОВАТЬ ПО Ост.Номенклатура, Ост.Магазин, Ост.Организация, Ост.Характеристика
	|ИМЕЮЩИЕ СУММА(Ост.КоличествоОстаток) > 0
	|УПОРЯДОЧИТЬ ПО Количество УБЫВ, СсылкаОрганизации, СсылкаМагазина, СсылкаХарактеристики");
	Запрос.УстановитьПараметр("Товары", Товары);
	Результат = Новый Соответствие;
	Если Товары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Место = Новый Структура("store, organization, variant, quantity",
			Выборка.Магазин, Выборка.Организация, Выборка.Характеристика, Выборка.Количество);
		Единица = Выборка.Товар.ОсновнаяЕдиницаИзмерения;
		Цена = Цены.Получить(Выборка.Товар);
		Если Цена <> Неопределено И Цена > 0 И ЗначениеЗаполнено(Единица) И Единица.Коэффициент = 1
			И ЗначениеЗаполнено(Выборка.СсылкаОрганизации) И ЗначениеЗаполнено(Выборка.СсылкаМагазина)
			И Не Выборка.СсылкаОрганизации.ПометкаУдаления И Не Выборка.СсылкаМагазина.ПометкаУдаления
			И Не ЗапрещенаОтгрузкаОрганизации(Выборка.СсылкаОрганизации) Тогда
			Место.Вставить("organization_id", Строка(Выборка.СсылкаОрганизации.УникальныйИдентификатор()));
			Место.Вставить("store_id", Строка(Выборка.СсылкаМагазина.УникальныйИдентификатор()));
			Место.Вставить("is_default", Выборка.СсылкаОрганизации = Настройки.Организация
				И Выборка.СсылкаМагазина = Настройки.Магазин);
			Место.Вставить("price", Цена);
			Если ЗначениеЗаполнено(Выборка.СсылкаХарактеристики) Тогда
				Место.Вставить("variant_id", Строка(Выборка.СсылкаХарактеристики.УникальныйИдентификатор()));
			КонецЕсли;
		КонецЕсли;
		Места = Результат.Получить(Выборка.Товар);
		Если Места = Неопределено Тогда
			Места = Новый Массив;
			Результат.Вставить(Выборка.Товар, Места);
		КонецЕсли;
		Места.Добавить(Место);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция customerOrderGet(Запрос) Экспорт
	Попытка
		СтрокаПоиска = ПараметрТоваров(Запрос, "q");
		Штрихкод = ПараметрТоваров(Запрос, "barcode");
		Позиции = Новый Массив;
		Усечено = Ложь;
		Найдено = 0;
		Причина = "";
		Настройки = НастройкиОтгрузки(Запрос);
		Если Не ПустаяСтрока(СтрокаПоиска) ИЛИ Не ПустаяСтрока(Штрихкод) Тогда
			Если ПараметрТоваров(Запрос, "exact") = "1" И ПустаяСтрока(Штрихкод) Тогда
				Товары = Новый Массив;
				Товар = Справочники.Номенклатура.НайтиПоКоду(Число(СтрокаПоиска));
				Если ЗначениеЗаполнено(Товар) И Не Товар.ПометкаУдаления И Не Товар.ЭтоГруппа Тогда
					Товары.Добавить(Товар);
				КонецЕсли;
			Иначе
				Товары = НайтиТоварыЗаказа(СтрокаПоиска, Штрихкод);
			КонецЕсли;
			Найдено = Товары.Количество();
			Усечено = Найдено > 50;
			Если Усечено Тогда
				Товары.Удалить(50);
			КонецЕсли;
			Если Товары.Количество() > 0 Тогда
				Остатки = ОстаткиОтгрузки(Настройки, Товары);
				Цены = ТоварыЦены(Товары);
				Для Каждого Товар Из Товары Цикл
					Остаток = Остатки.Найти(Товар, "Товар");
					Цена = Цены.Получить(Товар);
					Единица = Товар.ОсновнаяЕдиницаИзмерения;
					// возвращаем конкретную причину для однозначного совпадения
					Если Остаток = Неопределено Тогда
						Причина = "stock";
					ИначеЕсли Цена = Неопределено ИЛИ Цена <= 0 Тогда
						Причина = "price";
					ИначеЕсли Не ЗначениеЗаполнено(Единица) ИЛИ Единица.Коэффициент <> 1 Тогда
						Причина = "unit";
					Иначе
						Причина = "";
					КонецЕсли;
					Если Не ПустаяСтрока(Причина) Тогда
						Продолжить;
					КонецЕсли;
					Позиции.Добавить(Новый Структура("Code, Name, quantity, price",
						Формат(Товар.Код, "ЧГ=0"), Товар.Наименование, Остаток.Количество, Цена));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Данные = Новый Структура("items, truncated, matched_count", Позиции, Усечено, Найдено);
		Данные.Вставить("organization", Настройки.Организация.Наименование);
		Данные.Вставить("store", Настройки.Магазин.Наименование);
		Если Найдено = 1 Тогда
			ЦенаТовара = Цены.Получить(Товары[0]);
			Данные.Вставить("price", ?(ЦенаТовара = Неопределено, 0, ЦенаТовара));
			Если Позиции.Количество() = 0 Тогда
				Данные.Вставить("unavailable_reason", Причина);
			КонецЕсли;
			МестаПоТоварам = МестаОстатковТоваров(Товары, Настройки, Цены);
			Места = МестаПоТоварам.Получить(Товары[0]);
			Данные.Вставить("stock_locations", ?(Места = Неопределено, Новый Массив, Места));
		КонецЕсли;
		Возврат ТоварыОтвет(200, ТоварыВJSON(Данные), "GET, POST, OPTIONS");
	Исключение
		Возврат ОшибкаОтгрузки(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецФункции

// подтверждает сохраненный заказ и возвращает тот же номер при повторе
Функция ДанныеОтветаЗаказа(Документ, Повтор)
	Данные = Новый Структура("ok, document_type, doc_number, doc_date, sum, duplicate",
		Истина, "customer_order", СокрЛП(Строка(Документ.Номер)),
		Формат(Документ.Дата, "ДФ=yyyy-MM-dd HH:mm:ss"), Документ.Состав.Итог("Сумма"), Повтор);
	Данные.Вставить("organization", Документ.Организация.Наименование);
	Данные.Вставить("store", Документ.Магазин.Наименование);
	Возврат Данные;
КонецФункции


Функция ОшибкаОтгрузки(Сообщение)
	Данные = Новый Структура("ok, error", Ложь, Сообщение);
	Возврат ТоварыОтвет(400, ТоварыВJSON(Данные), "GET, POST, OPTIONS");
КонецФункции

// проверяет остатки и записывает заказ кпк
Функция customerOrderPost(Запрос) Экспорт
	ТранзакцияНачата = Ложь;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		Если ТипЗнч(Данные) <> Тип("Структура") Тогда
			ВызватьИсключение "Некоректний запит замовлення.";
		КонецЕсли;
		Если Данные.Свойство("technician_id")
			И СокрЛП(Строка(Данные.technician_id)) <> КодСотрудникаЗапроса(Запрос) Тогда
			ВызватьИсключение "Користувач запиту не відповідає сесії.";
		КонецЕсли;
		Группы = Неопределено;
		Пакет = Данные.Свойство("groups", Группы);
		Если Не Пакет Тогда
			Группы = Новый Массив;
			Группы.Добавить(Данные);
		КонецЕсли;
		Если ТипЗнч(Группы) <> Тип("Массив") Или Группы.Количество() = 0 Тогда
			ВызватьИсключение "Порожній склад документа.";
		КонецЕсли;
		// все группы пишем вместе, при ошибке откатываем весь заказ
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		ТранзакцияНачата = Истина;
		ДокументыОтвета = Новый Массив;
		Источники = Новый Соответствие;
		Для Каждого Группа Из Группы Цикл
			Документ = ЗаписатьГруппуЗаказа(Запрос, Группа, Источники);
			ДокументыОтвета.Добавить(ДанныеОтветаЗаказа(Документ, Ложь));
		КонецЦикла;
		ДанныеОтвета = ДокументыОтвета[0];
		Если Пакет Тогда
			ДанныеОтвета = Новый Структура("ok, documents", Истина, ДокументыОтвета);
		КонецЕсли;
		Ответ = ТоварыОтвет(200, ТоварыВJSON(ДанныеОтвета), "GET, POST, OPTIONS");
		ЗафиксироватьТранзакцию();
		Возврат Ответ;
	Исключение
		Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат ОшибкаОтгрузки(Сообщение);
	КонецПопытки;
КонецФункции

// проверяет источник и остатки для одного документа
Функция ЗаписатьГруппуЗаказа(Запрос, Группа, Источники)
	Если ТипЗнч(Группа) <> Тип("Структура") Или Не Группа.Свойство("items")
		Или ТипЗнч(Группа.items) <> Тип("Массив") Или Группа.items.Количество() = 0 Тогда
		ВызватьИсключение "Порожній склад документа.";
	КонецЕсли;
	Источник = Неопределено;
	Если Группа.Свойство("source") Тогда
		Источник = Группа.source;
		Если Источник = Неопределено Тогда
			ВызватьИсключение "Не вказано джерело залишку.";
		КонецЕсли;
	КонецЕсли;
	Настройки = НастройкиОтгрузки(Запрос, Источник);
	КлючИсточника = Строка(Настройки.Организация.УникальныйИдентификатор()) + ":" + Строка(Настройки.Магазин.УникальныйИдентификатор());
	Если Источники.Получить(КлючИсточника) <> Неопределено Тогда
		ВызватьИсключение "Організація та магазин повторюються в замовленні.";
	КонецЕсли;
	Источники.Вставить(КлючИсточника, Истина);
	Контрагент = НайтиРеквизитЗаказа("Контрагенты", "Основной покупатель");

	Товары = Новый Массив;
	Строки = Новый Массив;
	Ключи = Новый Соответствие;
	Для Каждого Позиция Из Группа.items Цикл
		Если ТипЗнч(Позиция) <> Тип("Структура")
			ИЛИ Не Позиция.Свойство("code") ИЛИ Не Позиция.Свойство("qty") Тогда
			ВызватьИсключение "Некоректна позиція товару.";
		КонецЕсли;
		Код = СокрЛП(Строка(Позиция.code));
		Если ПустаяСтрока(Код) Тогда
			ВызватьИсключение "Відсутній код товару.";
		КонецЕсли;
		Товар = Справочники.Номенклатура.НайтиПоКоду(Число(Код));
		Если Не ЗначениеЗаполнено(Товар) ИЛИ Товар.ПометкаУдаления ИЛИ Товар.ЭтоГруппа Тогда
			ВызватьИсключение "Товар не знайдено: " + Код;
		КонецЕсли;
		Количество = Число(Позиция.qty);
		Если Количество <= 0 ИЛИ Количество <> Окр(Количество, 3) ИЛИ Количество >= 1000000000 Тогда
			ВызватьИсключение "Вкажіть додатну кількість із точністю до трьох знаків.";
		КонецЕсли;
		Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
		Идентификатор = "";
		Если Позиция.Свойство("variant_id", Идентификатор) И Не ПустаяСтрока(Идентификатор) Тогда
			Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Если Не ЗначениеЗаполнено(Характеристика) Тогда
				ВызватьИсключение "Не знайдено характеристику товару: " + Код;
			КонецЕсли;
		КонецЕсли;
		Ключ = Строка(Товар.УникальныйИдентификатор()) + ":" + Строка(Характеристика.УникальныйИдентификатор());
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение "Товар і характеристика повторюються у документі.";
		КонецЕсли;
		Ключи.Вставить(Ключ, Истина);
		Строки.Добавить(Новый Структура("Товар, Количество, Характеристика", Товар, Количество, Характеристика));
		Товары.Добавить(Товар);
	КонецЦикла;

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.Остатки");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Магазин", Настройки.Магазин);
	Элемент.УстановитьЗначение("Организация", Настройки.Организация);
	Блокировка.Заблокировать();

	Цены = ТоварыЦены(Товары);
	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Документ.Дата = ТекущаяДата();
	Документ.Организация = Настройки.Организация;
	Документ.Магазин = Настройки.Магазин;
	Документ.ТипЦен = Настройки.ТипЦен;
	Документ.Контрагент = Контрагент;
	Документ.Грузополучатель = Контрагент;
	Документ.Автор = Настройки.Пользователь;
	Документ.Менеджер = Настройки.Сотрудник;
	Документ.Валюта = глЗначениеПеременной("ОсновнаяВалюта");
	Документ.КПК = Истина;
	Для Каждого Позиция Из Строки Цикл
		Товар = Позиция.Товар;
		Количество = Позиция.Количество;
		ТоварыСтроки = Новый Массив;
		ТоварыСтроки.Добавить(Товар);
		ОстаткиСтроки = ОстаткиОтгрузки(Настройки, ТоварыСтроки, Позиция.Характеристика);
		Доступно = ?(ОстаткиСтроки.Количество() = 0, Неопределено, ОстаткиСтроки[0].Количество);
		Если Доступно = Неопределено ИЛИ Количество > Доступно Тогда
			ВызватьИсключение "Недостатній залишок: " + Товар.Наименование;
		КонецЕсли;
		Цена = Цены.Получить(Товар);
		Если Цена = Неопределено ИЛИ Цена <= 0 Тогда
			ВызватьИсключение "Не знайдено ціни: " + Товар.Наименование;
		КонецЕсли;
		Единица = Товар.ОсновнаяЕдиницаИзмерения;
		Если Не ЗначениеЗаполнено(Единица) Тогда
			ВызватьИсключение "Не вказано основну одиницю: " + Товар.Наименование;
		КонецЕсли;
		Если Единица.Коэффициент <> 1 Тогда
			ВызватьИсключение "Основна одиниця потребує перерахунку залишку: " + Товар.Наименование;
		КонецЕсли;
		СтрокаДокумента = Документ.Состав.Добавить();
		СтрокаДокумента.Номенклатура = Товар;
		Если ЗначениеЗаполнено(Позиция.Характеристика) Тогда
			СтрокаДокумента.Характеристика = Позиция.Характеристика;
		КонецЕсли;
		СтрокаДокумента.Магазин = Настройки.Магазин;
		СтрокаДокумента.ЕдиницаИзмерения = Единица;
		СтрокаДокумента.Коэффициент = 1;
		СтрокаДокумента.Количество = Количество;
		СтрокаДокумента.Цена = Цена;
		СтрокаДокумента.Сумма = Окр(Количество * Цена, 2);
		СтрокаДокумента.КоличествоЗаказ = Количество;
		СтрокаДокумента.СуммаЗаказ = СтрокаДокумента.Сумма;
	КонецЦикла;
	Документ.Сумма = Документ.Состав.Итог("Сумма");
	Документ.СуммаДокумента = Документ.Сумма;
	Документ.Записать(РежимЗаписиДокумента.Запись);
	Возврат Документ;
КонецФункции

Функция customerOrderOptions(Запрос) Экспорт
	Возврат ТоварыОтвет(200, "", "GET, POST, OPTIONS", Ложь);
КонецФункции

// старый маршрут возвращает явный отказ до обновления клиента
Функция shipmentget(Запрос) Экспорт
	Возврат ТоварыОтвет(410, "Оновіть сайт для створення замовлення.", "GET, POST, OPTIONS", Ложь);
КонецФункции

Функция POST_Shipment(Запрос) Экспорт
	Возврат shipmentget(Запрос);
КонецФункции

Функция shipmentoptions(Запрос) Экспорт
	Возврат customerOrderOptions(Запрос);
КонецФункции
